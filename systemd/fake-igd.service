[Unit]
Description=fake-igd - a fake UPnP IGD that logs which ports devices ask for
Documentation=file:@OPT@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fake-igd
Group=fake-igd
ExecStart=@VENV@/bin/python -I @OPT@/fake-igd.py --config @ETC@/config.json
Restart=on-failure
RestartSec=5
UMask=0027

StateDirectory=fake-igd
LogsDirectory=fake-igd
StateDirectoryMode=0750
LogsDirectoryMode=0750

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# As otp.service (1.7.6): no capability at all (1900/udp and the SOAP port are above 1024), and only the
# system calls a service makes. AF_INET6: an ntfy server reached over IPv6 failed with EAFNOSUPPORT.
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
