[Unit]
Description=fake-igd - falesny UPnP IGD (logovani pozadavku na porty)
Documentation=file:@OPT@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fake-igd
Group=fake-igd
ExecStart=@VENV@/bin/python -I @OPT@/fake-igd.py --config @ETC@/config.json
Restart=on-failure
RestartSec=5
UMask=0027

StateDirectory=fake-igd
LogsDirectory=fake-igd
StateDirectoryMode=0750
LogsDirectoryMode=0750

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
