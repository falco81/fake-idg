# /etc/systemd/system/fake-igd-api.service (1.4.0)
#
# The API the web pages ask: 127.0.0.1:9862 (api_port) - and SNMPv3 when it is on (1.7.2), the token in
# /run/fake-igd-api for the pages' group (fake-igd-web) alone. Its own account
# (fake-igd), apart from fake-igd.service, so that the pages stay while the
# UPnP service restarts after a change of its settings. The shape of otp.service.
[Unit]
Description=fake-igd - the API of the web pages (127.0.0.1)
Documentation=file:@OPT@/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=@VENV@/bin/python -I @OPT@/fake_igd_api.py --config @ETC@/config.json
Restart=always
RestartSec=3
User=fake-igd
Group=fake-igd
SupplementaryGroups=fake-igd-web systemd-journal
UMask=0027
RuntimeDirectory=fake-igd-api
RuntimeDirectoryMode=0750
StateDirectory=fake-igd
StateDirectoryMode=0750
ReadWritePaths=/var/lib/fake-igd /etc/fake-igd
ReadOnlyPaths=/var/log/fake-igd
# SNMPv3 on 161 (1.7.2, as otp.service since otp 1.0.182): the API answers it itself, and a port
# below 1024 needs this - binding it, nothing else. The pages' port is 127.0.0.1:9862, above 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
