# /etc/systemd/system/fake-igd-web.service (1.4.0, otp's otp-web.service)
[Unit]
Description=fake-igd - what the pages asked of root
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/fake-igd/fake_igd_web.py
# Making DH parameters of 4096 bits here takes from minutes to half an hour on a slow machine: as otp's
# otp-web.service (1.7.8) - 5 min ended it half way, and the pages waited for ever.
TimeoutStartSec=30min
