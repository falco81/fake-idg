# shellcheck shell=bash
# bash completion for upnp (fake-igd)
_upnp() {
  local cur prev cmd i
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  local cmds="status ports requests mappings clients log dnat firewall mdns notify notify-test config mode response test start stop restart enable disable clear upgrade user web version api events check backup db updates time tls acme net mail-test siem-test proxy-test snmp-trap export-config import-config power gateway selinux help"
  local keys="mode mapping_response http_port external_ip interfaces exclude_interfaces allowed_clients ntfy_url notify_on_renew log_level log_file request_log state_dir interface_rescan_seconds notify_interval_seconds site_name api_port session_idle_minutes web_allow firewall firewall_ssh firewall_icmp upgrade_url upgrade_check ntfy_token ntfy_user ntfy_password ntfy_priority ntfy_tags ntfy_ca_file notify_other_router ntfy_events ntfy_quiet_from ntfy_quiet_to ntfy_quiet_priority ntfy_quiet_summary ntfy_rate_per_hour"
  local glob="--config --color --no-color --no-dns -h --help"

  cmd=""
  for ((i = 1; i < COMP_CWORD; i++)); do
    case "${COMP_WORDS[i]}" in
      --config|--color) ((i++)) ;;
      -*) ;;
      *) cmd="${COMP_WORDS[i]}"; break ;;
    esac
  done

  case "$prev" in
    --config) COMPREPLY=($(compgen -f -- "$cur")); return ;;
    --color) COMPREPLY=($(compgen -W "auto always never" -- "$cur")); return ;;
    --proto) COMPREPLY=($(compgen -W "tcp udp" -- "$cur")); return ;;
    --format|-F)
      if [[ " ${COMP_WORDS[*]} " == *" firewall "* || " ${COMP_WORDS[*]} " == *" fw "* ]]; then
        COMPREPLY=($(compgen -W "auto iptables nft firewalld" -- "$cur"))
      else
        COMPREPLY=($(compgen -W "iptables nft mikrotik firewalld" -- "$cur"))
      fi
      return ;;
    --interface|-i) COMPREPLY=($(compgen -W "$(ls /sys/class/net 2>/dev/null)" -- "$cur")); return ;;
    --level) COMPREPLY=($(compgen -W "DEBUG INFO WARNING ERROR" -- "$cur")); return ;;
    --action) COMPREPLY=($(compgen -W "AddPortMapping DeletePortMapping Expired" -- "$cur")); return ;;
    --since) COMPREPLY=($(compgen -W "30m 1h 2h 1d 7d" -- "$cur")); return ;;
    --client|--target|--wan|--grep|--st|--timeout|--add|-n|--min-count|--source|-s|--zone) return ;;
  esac

  case "$prev" in
    --console-at-login) COMPREPLY=($(compgen -W "on off status" -- "$cur")); return ;;
    --console-users) COMPREPLY=($(compgen -W "none '*'" -- "$cur")); return ;;
  esac
  if [[ -z "$cmd" ]]; then
    COMPREPLY=($(compgen -W "$cmds $glob --console --console-at-login --console-users" -- "$cur")); return
  fi

  case "$cmd" in
    status|st)      COMPREPLY=($(compgen -W "--json $glob" -- "$cur")) ;;
    version|start|stop|restart|enable|disable)
      COMPREPLY=($(compgen -W "$glob" -- "$cur")) ;;
    ports|p)        COMPREPLY=($(compgen -W "--client --proto --since --min-count --port --json $glob" -- "$cur")) ;;
    requests|req|r) COMPREPLY=($(compgen -W "-n --client --action --since --json $glob" -- "$cur")) ;;
    mappings|m)     COMPREPLY=($(compgen -W "--json $glob" -- "$cur")) ;;
    upgrade|up)
      if [[ "$prev" == file ]]; then COMPREPLY=($(compgen -f -X '!*.tar.gz' -- "$cur")); compopt -o plusdirs 2>/dev/null; return; fi
      COMPREPLY=($(compgen -W "check online file status follow log --yes --no-follow --downgrade --json -n $glob" -- "$cur")) ;;
    user|users)
      if [[ "$prev" == --role ]]; then COMPREPLY=($(compgen -W "fulladmin readonly" -- "$cur")); return; fi
      COMPREPLY=($(compgen -W "list add passwd role note del sessions end --role --password --note --yes --json $glob" -- "$cur")) ;;
    web)            COMPREPLY=($(compgen -W "status apply --restart $glob" -- "$cur")) ;;
    clients|c)      COMPREPLY=($(compgen -W "--since --json $glob" -- "$cur")) ;;
    log|l)          COMPREPLY=($(compgen -W "-n -f --follow -e --events --level --grep --since --raw $glob" -- "$cur")) ;;
    dnat|d)         COMPREPLY=($(compgen -W "--format --wan --client --proto --since --min-count --port --no-forward --quiet $glob" -- "$cur")) ;;
    mdns|avahi)
      local sub="" j
      for ((j = i + 1; j < COMP_CWORD; j++)); do [[ "${COMP_WORDS[j]}" != -* ]] && { sub="${COMP_WORDS[j]}"; break; }; done
      if [[ -z "$sub" ]]; then
        COMPREPLY=($(compgen -W "status services browse reflector interfaces filters ipv6 ipv4 reflect-ipv set config start stop restart enable disable log" -- "$cur"))
      else
        case "$sub" in
          reflector|ipv6|ipv4|reflect-ipv) COMPREPLY=($(compgen -W "on off --no-restart" -- "$cur")) ;;
          interfaces) COMPREPLY=($(compgen -W "all $(ls /sys/class/net 2>/dev/null) --no-restart" -- "$cur")) ;;
          filters) COMPREPLY=($(compgen -W "none _airplay._tcp _raop._tcp _googlecast._tcp _ipp._tcp _spotify-connect._tcp --no-restart" -- "$cur")) ;;
          set) COMPREPLY=($(compgen -W "use-ipv4 use-ipv6 allow-interfaces deny-interfaces cache-entries-max ratelimit-interval-usec ratelimit-burst enable-wide-area publish-hinfo publish-workstation disable-publishing enable-reflector reflect-ipv reflect-filters" -- "$cur")) ;;
          services) COMPREPLY=($(compgen -W "--json --type --iface --no-resolve --timeout" -- "$cur")) ;;
          log) COMPREPLY=($(compgen -W "-n -f --follow" -- "$cur")) ;;
          status|config) COMPREPLY=($(compgen -W "--json" -- "$cur")) ;;
        esac
      fi ;;
    notify-test|nt) COMPREPLY=($(compgen -W "$glob" -- "$cur")) ;;
    notify)
      local nsub="" j
      for ((j = i + 1; j < COMP_CWORD; j++)); do [[ "${COMP_WORDS[j]}" != -* ]] && { nsub="${COMP_WORDS[j]}"; break; }; done
      if [[ -z "$nsub" ]]; then
        COMPREPLY=($(compgen -W "list on off test" -- "$cur"))
      elif [[ "$nsub" == list ]]; then
        COMPREPLY=($(compgen -W "--json $glob" -- "$cur"))
      else
        COMPREPLY=($(compgen -W "port_new port_renew port_refused port_deleted port_expired device_new device_stopped other_router public_ip iface service service_crash gw_online gw_drops gw_forward gw_rule_first alerts alerts_over --no-restart" -- "$cur"))
      fi ;;
    api)            COMPREPLY=($(compgen -W "GET POST /api/status /api/events /api/db /api/backup /api/osup /api/time /api/tls /api/acme /api/net /api/alerts /api/settings -" -- "$cur")) ;;
    events|ev)      COMPREPLY=($(compgen -W "--search --kind --hours -n --limit --json $glob" -- "$cur")) ;;
    check|tls|net|siem-test|snmp-trap) COMPREPLY=($(compgen -W "--json $glob" -- "$cur")) ;;
    backup)         COMPREPLY=($(compgen -W "status now verify --json $glob" -- "$cur")) ;;
    db)             COMPREPLY=($(compgen -W "status check copy tidy vacuum --json $glob" -- "$cur")) ;;
    updates)        COMPREPLY=($(compgen -W "status check start stop reboot --security --reboot --no-follow --yes --json $glob" -- "$cur")) ;;
    time)           COMPREPLY=($(compgen -W "status sync --json $glob" -- "$cur")) ;;
    acme)           COMPREPLY=($(compgen -W "status order --json $glob" -- "$cur")) ;;
    mail-test)      COMPREPLY=($(compgen -W "--kind --straight --json $glob" -- "$cur")) ;;
    proxy-test)     COMPREPLY=($(compgen -W "--json $glob" -- "$cur")) ;;
    export-config)  COMPREPLY=($(compgen -f -W "--with-secrets" -- "$cur")) ;;
    import-config)  COMPREPLY=($(compgen -f -W "--replace --yes" -- "$cur")) ;;
    power)          COMPREPLY=($(compgen -W "status reboot poweroff cancel --in --yes --json $glob" -- "$cur")) ;;
    gateway)        COMPREPLY=($(compgen -W "status on off add del keep back dns rule try top conns list --name --mac --mac-seen --to --proto --ports --comment --dot --yes --json $glob" -- "$cur")) ;;
    selinux)        COMPREPLY=($(compgen -W "check look fix rules prepare apply enforce permissive report --all --take-away --yes --json $glob" -- "$cur")) ;;
    firewall|fw)    COMPREPLY=($(compgen -W "--format --interface --source --zone --apply --off --status $glob" -- "$cur")) ;;
    test|t)         COMPREPLY=($(compgen -W "--st --timeout --target --add $glob" -- "$cur")) ;;
    clear)          COMPREPLY=($(compgen -W "--requests --log --all -y --yes" -- "$cur")) ;;
    mode)           COMPREPLY=($(compgen -W "active passive --no-restart" -- "$cur")) ;;
    response)       COMPREPLY=($(compgen -W "accept reject --no-restart" -- "$cur")) ;;
    help)           COMPREPLY=($(compgen -W "$cmds" -- "$cur")) ;;
    config|cfg)
      local sub="" j
      for ((j = i + 1; j < COMP_CWORD; j++)); do [[ "${COMP_WORDS[j]}" != -* ]] && { sub="${COMP_WORDS[j]}"; break; }; done
      if [[ -z "$sub" ]]; then
        COMPREPLY=($(compgen -W "show get set edit validate path" -- "$cur"))
      elif [[ "$sub" == get || "$sub" == set ]] && (( COMP_CWORD == j + 1 )); then
        COMPREPLY=($(compgen -W "$keys" -- "$cur"))
      elif [[ "$sub" == set ]] && (( COMP_CWORD == j + 2 )); then
        case "${COMP_WORDS[j+1]}" in
          mode) COMPREPLY=($(compgen -W "active passive" -- "$cur")) ;;
          mapping_response) COMPREPLY=($(compgen -W "accept reject" -- "$cur")) ;;
          log_level) COMPREPLY=($(compgen -W "DEBUG INFO WARNING ERROR" -- "$cur")) ;;
          notify_on_renew) COMPREPLY=($(compgen -W "true false" -- "$cur")) ;;
        esac
      else
        COMPREPLY=($(compgen -W "--no-restart --json" -- "$cur"))
      fi ;;
  esac
}
complete -F _upnp upnp
